{
  "name": "causalscope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "tsx apps/api/main.ts",
    "dev:ingest": "tsx apps/ingest/main.ts",
    "dev:analyzer": "tsx apps/analyzer/main.ts",
    "dev:demo": "tsx apps/demo-system/main.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "format": "prettier --write apps packages scripts tests docs *.md *.json *.ts *.yaml *.yml"
  },
  "dependencies": {
    "@clickhouse/client": "^1.15.0",
    "@google/genai": "^1.30.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.90.10",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.23.24",
    "pino": "^10.1.0",
    "protobufjs": "^7.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.9.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.1",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.0.8"
  }
}
