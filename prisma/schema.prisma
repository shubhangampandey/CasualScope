generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
// Typed domain records are validated by API schemas. Composite tenant keys are mandatory.
model StoredRecord {
  workspace String
  kind String
  id String
  data Json
  updated DateTime @updatedAt
  @@id([workspace, kind, id])
  @@index([workspace, kind, updated])
}
// Intentionally separate from observations and inaccessible to the inference package.
model FaultGroundTruth {
  workspace String
  id String
  data Json
  @@id([workspace,id])
}

model TelemetrySpan {
  workspace String
  environment String
  traceId String
  spanId String
  service String
  start Float
  data Json
  @@id([workspace, environment, traceId, spanId])
  @@index([workspace, environment, start])
  @@index([workspace, environment, traceId, start])
  @@index([workspace, environment, service, start])
  @@index([start])
}

model TelemetryLog {
  workspace String
  environment String
  id String
  traceId String
  service String
  time Float
  data Json
  @@id([workspace, environment, id])
  @@index([workspace, environment, time])
  @@index([workspace, environment, traceId, time])
  @@index([time])
}
